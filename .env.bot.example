# ADICIONE estas variáveis ao .env LOCAL ou ao painel da Vercel. Nunca commite credenciais!
# Padrão seguro: nenhum envio real será feito.
WHATSAPP_MODE="SIMULACAO"

# Verificação GET do webhook / assinatura HMAC dos eventos POST
WHATSAPP_VERIFY_TOKEN="gere_um_token_aleatorio_grande"
WHATSAPP_APP_SECRET="app_secret_da_meta"

# Somente no modo REAL, com credenciais e template aprovados
WHATSAPP_TOKEN="token_da_meta"
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_GRAPH_VERSION="v24.0"
WHATSAPP_TEMPLATE_NAME="saga_alerta_academico"
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"

# Para permitir à Meta acessar as imagens do horário PUBLICADO pelo link HTTPS
WHATSAPP_SITE_URL="https://saga-liard.vercel.app"
# Segredo aleatório (mínimo 32 caracteres) para links PNG de uso temporário pela Meta.
# A grade NÃO é aberta ao público.
WHATSAPP_IMAGE_SECRET="gere_um_segredo_aleatorio_de_pelo_menos_32_caracteres"

# Worker protegido para processamento em lote por POST (opcional)
WHATSAPP_WORKER_SECRET="gere_outro_token_aleatorio_grande"
