# Copie este arquivo para ".env" e preencha com os endereços do banco (Neon).
# Os endereços têm a senha do banco: peça em conversa particular e nunca envie o .env para o GitHub ou para o grupo.
#   DATABASE_URL: conexão com pool (no Neon, o endereço que tem "-pooler"), usada pelo site
#   DIRECT_URL:   conexão direta (sem "-pooler"), usada para criar e alterar tabelas
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
