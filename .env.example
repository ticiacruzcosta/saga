# Copie este arquivo para ".env" e cole os endereços do seu banco no Neon (neon.tech).
# No painel do Neon: Dashboard > Connect. Use "Pooled connection" no DATABASE_URL e a conexão direta no DIRECT_URL.
# Na Vercel, cadastre as mesmas duas variáveis em Settings > Environment Variables.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require"
