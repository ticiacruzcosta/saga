{
  "name": "saga",
  "version": "1.0.0",
  "private": true,
  "description": "SAGA - Sistema de Avisos e Gestão Acadêmica (Faculdade Unisapiens)",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && prisma db push && next build",
    "start": "next start",
    "banco": "python seed.py --recriar --relatorio conferencia.xlsx",
    "banco:studio": "prisma studio",
    "test": "tsx --test tests/*.test.ts && node --test tests/bot-whatsapp.test.mjs && npm run test:telegram",
    "test:bot": "node --test tests/bot-whatsapp.test.mjs",
    "postinstall": "prisma generate",
    "banco:tabelas": "prisma db push",
    "migrar": "prisma db push && tsx scripts/migrar-para-postgres.ts",
    "telegram:polling": "node --env-file=.env --import tsx scripts/telegram-polling.ts",
    "telegram:webhook": "node --env-file=.env scripts/telegram-webhook.mjs",
    "test:telegram": "node --test tests/telegram.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "exceljs": "^4.4.0",
    "next": "16.4.3",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
